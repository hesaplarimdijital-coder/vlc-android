# Pinned sources of the native lab tools (SP-02, SP-05, S-802). Changing a line rebuilds them in CI.
FFMPEG_URL=https://github.com/FFmpeg/FFmpeg.git
FFMPEG_REF=n8.1.3
WHISPER_URL=https://github.com/ggml-org/whisper.cpp.git
WHISPER_REF=v1.9.5
# S-709: whisper on the GPU through ggml's Vulkan backend (the Android build), all of the Vulkan
# SDK 1.4.363.0: the headers it is compiled with, Vulkan-Hpp (Apache-2.0 or MIT) and SPIR-V's
# (MIT), and glslc (shaderc with glslang and SPIRV-Tools, Apache-2.0 and BSD), the build's own
# tool that makes ggml's shaders SPIR-V; it is not shipped. Ubuntu's glslc (shaderc 2023.8) lacks
# GL_EXT_integer_dot_product, without which ggml leaves out its 8-bit integer matrix shaders.
VULKAN_HEADERS_URL=https://github.com/KhronosGroup/Vulkan-Headers.git
VULKAN_HEADERS_REF=vulkan-sdk-1.4.363.0
SPIRV_HEADERS_URL=https://github.com/KhronosGroup/SPIRV-Headers.git
SPIRV_HEADERS_REF=vulkan-sdk-1.4.363.0
SHADERC_URL=https://github.com/google/shaderc.git
SHADERC_REF=v2026.4
GLSLANG_URL=https://github.com/KhronosGroup/glslang.git
GLSLANG_REF=vulkan-sdk-1.4.363.0
SPIRV_TOOLS_URL=https://github.com/KhronosGroup/SPIRV-Tools.git
SPIRV_TOOLS_REF=vulkan-sdk-1.4.363.0
LIBUSB_URL=https://github.com/libusb/libusb.git
LIBUSB_REF=v1.0.30
# S-907: TagLib writes the ReplayGain tags; utfcpp is its header-only dependency (the release tarball lacks it)
TAGLIB_URL=https://github.com/taglib/taglib.git
TAGLIB_REF=v2.0.2
UTFCPP_URL=https://github.com/nemtrif/utfcpp.git
UTFCPP_REF=v4.0.6
# S-911: libopenmpt renders the tracker formats (MOD, XM, S3M, IT, MPTM, …) for the music engine
OPENMPT_URL=https://github.com/OpenMPT/openmpt.git
OPENMPT_REF=libopenmpt-0.8.9
# S-1010: the converter's encoders, the music engine's own: libopus for Opus, LAME for MP3 (its
# official release, checked by its SHA-256: LAME is not kept in git)
OPUS_URL=https://github.com/xiph/opus.git
OPUS_REF=v1.5.2
LAME_URL=https://downloads.sourceforge.net/project/lame/lame/3.100/lame-3.100.tar.gz
LAME_SHA256=ddfe36cab873794038ae2c1210557ad34857a4b6bdc515785d1da9e175b1da1e
ANDROID_API=26
