+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE. See the
+ * GNU Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public License
+ * along with this program; if not, write to the Free Software Foundation,
+ * Inc., 51 Franklin Street, Fifth Floor, Boston MA 02110-1301, USA.
+ *****************************************************************************/
+
+/*
+ * The dialogue raised by a few decibels, the rest of the mix left alone:
+ *
+ *  - with a centre channel (5.1, 7.1 …), the centre channel, where the
+ *    dialogue of a film mix lives, is multiplied by the gain;
+ *  - in stereo, the part common to both channels (the "mid") is passed
+ *    through a band-pass filter around the voice (300 Hz – 4 kHz) and the
+ *    boosted band is added back to both channels, so that music and effects
+ *    panned to the sides keep their level.
+ *
+ * The gain changes on the fly ("nagdialogue-gain", in dB) and ramps over a
+ * few milliseconds so that it does not click. A soft clipper keeps a loud
+ * boost from wrapping.
+ */
+
+#ifdef HAVE_CONFIG_H
+# include "config.h"
+#endif
+
+#include <math.h>
+#include <stdatomic.h>
+
+#include <vlc_common.h>
+#include <vlc_aout.h>
+#include <vlc_filter.h>
+#include <vlc_plugin.h>
+
+#define CFG_PREFIX "nagdialogue-"
+
+#define GAIN_TEXT N_("Dialogue gain (dB)")
+#define GAIN_LONGTEXT N_("How much louder the dialogue is: the centre channel, " \
+    "or in stereo the voice band of what both channels share.")
+
+/* The band the voice lives in: a constant-peak band-pass around 1 kHz, wide
+ * enough (Q 0.6) to reach from about 300 Hz to 4 kHz. */
+#define VOICE_CENTRE_HZ 1000.f
+#define VOICE_Q 0.6f
+
+/* The gain ramps over this long, so that a change does not click. */
+#define RAMP_MS 20.f
+
+typedef struct
+{
+    /* The gain asked for, in dB, set from any thread */
+    _Atomic float gain_db;
+
+    /* Where the ramp is: the linear gain applied to the last sample */
+    float gain_now;
+    /* How much the linear gain moves per sample towards its target */
+    float gain_step;
+
+    /* The channel the dialogue is in, or -1 for stereo's mid */
+    int centre;
+    unsigned channels;
+
+    /* The voice band-pass (direct form I), for the stereo mid */
+    float b0, b1, b2, a1, a2;
+    float x1, x2, y1, y2;
+} filter_sys_t;
+
+static int GainCallback( vlc_object_t *obj, char const *var,
+                         vlc_value_t oldval, vlc_value_t newval, void *data )
+{
+    filter_sys_t *sys = data;
+    atomic_store( &sys->gain_db, newval.f_float );
+    (void) obj; (void) var; (void) oldval;
+    return VLC_SUCCESS;
+}
+
+static inline float SoftClip( float v )
+{
+    /* Linear up to 0.9, then a gentle knee that never passes 1 */
+    const float knee = 0.9f;
+    float a = fabsf( v );
+    if( a <= knee )
+        return v;
+    float over = ( a - knee ) / ( 1.f - knee );
+    float shaped = knee + ( 1.f - knee ) * ( over / ( 1.f + over ) );
+    return copysignf( shaped, v );
+}
+
+static block_t *Process( filter_t *filter, block_t *block )
+{
+    filter_sys_t *sys = filter->p_sys;
+    float *samples = (float *) block->p_buffer;
+    const unsigned channels = sys->channels;
+    const float target = powf( 10.f, atomic_load( &sys->gain_db ) / 20.f );
+
+    for( unsigned i = 0; i < block->i_nb_samples; i++, samples += channels )
+    {
+        /* The ramp towards the gain asked for */
+        if( sys->gain_now < target )
+            sys->gain_now = fminf( sys->gain_now + sys->gain_step, target );
+        else if( sys->gain_now > target )
+            sys->gain_now = fmaxf( sys->gain_now - sys->gain_step, target );
+        const float gain = sys->gain_now;
+
+        if( sys->centre >= 0 )
+        {
+            samples[sys->centre] = SoftClip( samples[sys->centre] * gain );
+            continue;
+        }
+
+        /* Stereo: the voice band of the mid, boosted and added back */
+        const float mid = 0.5f * ( samples[0] + samples[1] );
+        const float band = sys->b0 * mid + sys->b1 * sys->x1 + sys->b2 * sys->x2
+                         - sys->a1 * sys->y1 - sys->a2 * sys->y2;
+        sys->x2 = sys->x1;
+        sys->x1 = mid;
+        sys->y2 = sys->y1;
+        sys->y1 = band;
+
+        const float extra = band * ( gain - 1.f );
+        samples[0] = SoftClip( samples[0] + extra );
+        samples[1] = SoftClip( samples[1] + extra );
+    }
+    return block;
+}
+
+static void Flush( filter_t *filter )
+{
+    filter_sys_t *sys = filter->p_sys;
+    sys->x1 = sys->x2 = sys->y1 = sys->y2 = 0.f;
+}
+
+static void Close( filter_t *filter )
+{
+    filter_sys_t *sys = filter->p_sys;
+    vlc_object_t *aout = vlc_object_parent( filter );
+
+    var_DelCallback( aout, CFG_PREFIX "gain", GainCallback, sys );
+    var_Destroy( aout, CFG_PREFIX "gain" );
+    free( sys );
+}
+
+/* The index of the centre channel in VLC's channel order, or -1 without one */
+static int CentreIndex( const audio_sample_format_t *fmt )
+{
+    const uint32_t physical = fmt->i_physical_channels;
+    if( !( physical & AOUT_CHAN_CENTER ) )
+        return -1;
+    /* The channels that come before the centre in the WG4 order */
+    const uint32_t before = AOUT_CHAN_LEFT | AOUT_CHAN_RIGHT
+                          | AOUT_CHAN_MIDDLELEFT | AOUT_CHAN_MIDDLERIGHT
+                          | AOUT_CHAN_REARLEFT | AOUT_CHAN_REARRIGHT
+                          | AOUT_CHAN_REARCENTER;
+    return (int) vlc_popcount( physical & before );
+}
+
+static int Open( vlc_object_t *obj )
+{
+    filter_t *filter = (filter_t *) obj;
+    vlc_object_t *aout = vlc_object_parent( filter );
+    const audio_sample_format_t *fmt = &filter->fmt_in.audio;
+
+    if( fmt->i_format != VLC_CODEC_FL32
+     || !AOUT_FMTS_IDENTICAL( fmt, &filter->fmt_out.audio ) )
+        return VLC_EGENERIC;
+
+    const unsigned channels = aout_FormatNbChannels( fmt );
+    const int centre = CentreIndex( fmt );
+    if( centre < 0 && channels != 2 )
+    {
+        msg_Dbg( filter, "no dialogue channel in %u channels", channels );
+        return VLC_EGENERIC;
+    }
+    if( centre >= (int) channels )
+        return VLC_EGENERIC;
+
+    filter_sys_t *sys = malloc( sizeof( *sys ) );
+    if( unlikely( sys == NULL ) )
+        return VLC_ENOMEM;
+    filter->p_sys = sys;
+
+    sys->channels = channels;
+    sys->centre = centre;
+    sys->gain_now = 1.f;
+    sys->gain_step = ( powf( 10.f, 12.f / 20.f ) - 1.f )
+                   / ( RAMP_MS * fmt->i_rate / 1000.f );
+    sys->x1 = sys->x2 = sys->y1 = sys->y2 = 0.f;
+
+    /* RBJ constant-peak band-pass */
+    const float w0 = 2.f * (float) M_PI * VOICE_CENTRE_HZ / (float) fmt->i_rate;
+    const float alpha = sinf( w0 ) / ( 2.f * VOICE_Q );
+    const float a0 = 1.f + alpha;
+    sys->b0 = alpha / a0;
+    sys->b1 = 0.f;
+    sys->b2 = -alpha / a0;
+    sys->a1 = -2.f * cosf( w0 ) / a0;
+    sys->a2 = ( 1.f - alpha ) / a0;
+
+    atomic_init( &sys->gain_db, var_CreateGetFloat( aout, CFG_PREFIX "gain" ) );
+    var_AddCallback( aout, CFG_PREFIX "gain", GainCallback, sys );
+
+    msg_Dbg( filter, "dialogue boost on %s, %.1f dB",
+             centre >= 0 ? "the centre channel" : "the stereo mid",
+             atomic_load( &sys->gain_db ) );
+
+    static const struct vlc_filter_operations filter_ops =
+    {
+        .filter_audio = Process, .flush = Flush, .close = Close,
+    };
+    filter->ops = &filter_ops;
+    return VLC_SUCCESS;
+}
+
+vlc_module_begin()
+    set_shortname( N_("Dialogue") )
+    set_description( N_("Dialogue boost") )
+    set_subcategory( SUBCAT_AUDIO_AFILTER )
+    set_capability( "audio filter", 0 )
+    add_float_with_range( CFG_PREFIX "gain", 0.f, 0.f, 12.f, GAIN_TEXT, GAIN_LONGTEXT )
+    add_shortcut( "nagdialogue" )
+    set_callback( Open )
+vlc_module_end()
