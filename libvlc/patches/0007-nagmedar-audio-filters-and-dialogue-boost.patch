@@ -2166,6 +2168,9 @@ int libvlc_media_player_add_slave( libvlc_media_player_t *p_mi,
  */
 #define EQZ_BAND_VALUE_SIZE 12
 
+static void audio_filters_update( libvlc_media_player_t *, audio_output_t *,
+                                  bool, const char * );
+
 int libvlc_media_player_set_equalizer( libvlc_media_player_t *p_mi, libvlc_equalizer_t *p_equalizer )
 {
     char bands[EQZ_BANDS_MAX * EQZ_BAND_VALUE_SIZE + 1];
@@ -2183,21 +2188,95 @@ int libvlc_media_player_set_equalizer( libvlc_media_player_t *p_mi, libvlc_equal
         var_SetFloat( p_mi, "equalizer-preamp", p_equalizer->f_preamp );
         var_SetString( p_mi, "equalizer-bands", bands );
     }
-    var_SetString( p_mi, "audio-filter", p_equalizer ? "equalizer" : "" );
-
     audio_output_t *p_aout = vlc_player_aout_Hold( p_mi->player );
-    if( p_aout != NULL )
+    if( p_aout != NULL && p_equalizer != NULL )
     {
-        if( p_equalizer != NULL )
-        {
-            var_SetFloat( p_aout, "equalizer-preamp", p_equalizer->f_preamp );
-            var_SetString( p_aout, "equalizer-bands", bands );
-        }
+        var_SetFloat( p_aout, "equalizer-preamp", p_equalizer->f_preamp );
+        var_SetString( p_aout, "equalizer-bands", bands );
+    }
 
-        var_SetString( p_aout, "audio-filter", p_equalizer ? "equalizer" : "" );
+    /* Nağmedar: the equalizer joins the application's filters instead of replacing them */
+    audio_filters_update( p_mi, p_aout, p_equalizer != NULL, NULL );
+
+    if( p_aout != NULL )
         aout_Release(p_aout);
+
+    return 0;
+}
+
+/*
+ * Nağmedar: the audio filter chain is the equalizer, when it is on, followed by
+ * the filters the application asked for ("nagmedar-audio-filters"); either
+ * part changes without touching the other.
+ */
+static void audio_filters_update( libvlc_media_player_t *p_mi,
+                                  audio_output_t *p_aout, bool b_equalizer,
+                                  const char *psz_extra )
+{
+    char *psz_current = var_GetNonEmptyString( p_mi, "nagmedar-audio-filters" );
+    if( psz_extra != NULL )
+    {
+        var_SetString( p_mi, "nagmedar-audio-filters", psz_extra );
+        free( psz_current );
+        psz_current = *psz_extra ? strdup( psz_extra ) : NULL;
+    }
+
+    char *psz_chain;
+    if( b_equalizer && psz_current != NULL )
+    {
+        if( asprintf( &psz_chain, "equalizer:%s", psz_current ) == -1 )
+            psz_chain = NULL;
     }
+    else if( b_equalizer )
+        psz_chain = strdup( "equalizer" );
+    else
+        psz_chain = strdup( psz_current != NULL ? psz_current : "" );
+    free( psz_current );
+    if( psz_chain == NULL )
+        return;
+
+    var_SetString( p_mi, "audio-filter", psz_chain );
+    if( p_aout != NULL )
+        var_SetString( p_aout, "audio-filter", psz_chain );
+    free( psz_chain );
+}
+
+static bool audio_equalizer_on( libvlc_media_player_t *p_mi )
+{
+    char *psz_chain = var_GetNonEmptyString( p_mi, "audio-filter" );
+    bool b_on = psz_chain != NULL && strstr( psz_chain, "equalizer" ) != NULL;
+    free( psz_chain );
+    return b_on;
+}
 
+int libvlc_audio_set_filters( libvlc_media_player_t *p_mi, const char *psz_chain )
+{
+    audio_output_t *p_aout = vlc_player_aout_Hold( p_mi->player );
+    audio_filters_update( p_mi, p_aout, audio_equalizer_on( p_mi ),
+                          psz_chain != NULL ? psz_chain : "" );
+    if( p_aout != NULL )
+        aout_Release(p_aout);
+    return 0;
+}
+
+int libvlc_audio_set_filter_float( libvlc_media_player_t *p_mi,
+                                   const char *psz_name, float f_value )
+{
+    if( psz_name == NULL || !*psz_name )
+        return -1;
+
+    /* The media player keeps the value for the audio outputs to come… */
+    var_Create( p_mi, psz_name, VLC_VAR_FLOAT );
+    var_SetFloat( p_mi, psz_name, f_value );
+
+    /* …and the playing one takes it at once, through the filter's callback */
+    audio_output_t *p_aout = vlc_player_aout_Hold( p_mi->player );
+    if( p_aout != NULL )
+    {
+        var_Create( p_aout, psz_name, VLC_VAR_FLOAT | VLC_VAR_DOINHERIT );
+        var_SetFloat( p_aout, psz_name, f_value );
+        aout_Release(p_aout);
+    }
     return 0;
 }
 
