diff --git a/include/vlc/libvlc_media_player.h b/include/vlc/libvlc_media_player.h
index a9631f9a3d..dcccd3f4d0 100644
--- a/include/vlc/libvlc_media_player.h
+++ b/include/vlc/libvlc_media_player.h
@@ -2840,6 +2840,38 @@ LIBVLC_API libvlc_audio_output_mixmode_t libvlc_audio_get_mixmode( libvlc_media_
 LIBVLC_API int libvlc_audio_set_mixmode( libvlc_media_player_t *p_mi,
                                          libvlc_audio_output_mixmode_t mode );
 
+/**
+ * Set the audio filters an application adds beside the equalizer (Nağmedar).
+ *
+ * The chain is a list of audio filter modules separated by colons
+ * ("compressor:nagdialogue"); an empty chain removes them. The equalizer,
+ * when it is on (\see libvlc_media_player_set_equalizer), stays in front of
+ * them, and setting it does not remove them. The playing audio output takes
+ * the new chain at once.
+ *
+ * \param p_mi media player
+ * \param psz_chain the filters, or NULL for none
+ * \return 0 on success, -1 on error
+ * \version Nağmedar's LibVLC 4.0.0
+ */
+LIBVLC_API int libvlc_audio_set_filters( libvlc_media_player_t *p_mi,
+                                         const char *psz_chain );
+
+/**
+ * Set a floating point option of an audio filter (Nağmedar), such as
+ * "compressor-threshold" or "nagdialogue-gain": the playing audio output's
+ * filter takes it at once, and the audio outputs to come inherit it.
+ *
+ * \param p_mi media player
+ * \param psz_name the option's name
+ * \param f_value its value
+ * \return 0 on success, -1 on error
+ * \version Nağmedar's LibVLC 4.0.0
+ */
+LIBVLC_API int libvlc_audio_set_filter_float( libvlc_media_player_t *p_mi,
+                                              const char *psz_name,
+                                              float f_value );
+
 
