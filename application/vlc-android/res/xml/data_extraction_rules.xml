<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ backup and device transfer. Same content as backup_rules.xml: settings and
     Nağmedar's database (databases/nagmedar.db: podcasts, radio, lyrics, per-file settings)
     are kept; the medialibrary index is rebuilt by scanning, and keystores never leave the device. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="db"/>
        <exclude domain="root" path="app_db"/>
        <exclude domain="root" path="keystore"/>
        <exclude domain="root" path="app_keystore"/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="db"/>
        <exclude domain="root" path="app_db"/>
        <exclude domain="root" path="keystore"/>
        <exclude domain="root" path="app_keystore"/>
    </device-transfer>
</data-extraction-rules>
