    <string name="nag_settings_lab">Laboratuvar</string>
    <string name="nag_lab_intro">MVP0 deneylerinin bu cihazda çalışması gereken araçları. Her biri kopyalanabilir ya da paylaşılabilir bir rapor yazar.</string>
    <string name="nag_lab_audio_report">Ses çıkışı raporu</string>
    <string name="nag_lab_audio_report_desc">Çıkışlar, örnekleme hızları, kodlamalar ve bit-perfect mikserler. Önce USB DAC\'ı bağlayın.</string>
