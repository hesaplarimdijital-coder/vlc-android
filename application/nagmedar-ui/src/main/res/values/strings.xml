    <!-- Settings > Lab (MVP0 spikes) -->
    <string name="nag_settings_lab">Lab</string>
    <string name="nag_lab_intro">Tools of the MVP0 experiments that need this device. Each one writes a report to copy or share.</string>
    <string name="nag_lab_audio_report">Audio output report</string>
    <string name="nag_lab_audio_report_desc">Outputs, sample rates, encodings and bit-perfect mixers. Connect the USB DAC first.</string>
    <string name="nag_lab_bit_perfect">Try bit-perfect mode</string>
    <string name="nag_lab_bit_perfect_desc">Sets the USB DAC\'s bit-perfect mixer for media, reads it back and clears it again.</string>
    <string name="nag_lab_display_report">Display report</string>
    <string name="nag_lab_display_report_desc">Modes, refresh rates, HDR types and EDID of every display. Connect the TV first.</string>
    <string name="nag_lab_refresh_rate">Try 23.976 Hz on the TV</string>
    <string name="nag_lab_refresh_rate_desc">Shows a black screen on the external display, asks for the 24p mode and reports what the TV did.</string>
    <string name="nag_lab_media3">Media session</string>
    <string name="nag_lab_media3_desc">Lock screen, notification, Bluetooth and Android Auto controls go through the Media3 session. Applies the next time playback starts after the player was closed.</string>
    <string name="nag_lab_media3_legacy">Classic</string>
    <string name="nag_lab_media3_on">Media3</string>
    <string name="nag_lab_stop">Stop</string>
    <string name="nag_lab_native_missing">This build has no native lab library (USB, Dolby Vision and whisper tools). Use the APK from CI.</string>
    <string name="nag_lab_option_duration">Duration</string>
    <string name="nag_lab_option_container">Container</string>
    <string name="nag_lab_option_model">Model</string>
    <string name="nag_lab_option_rate">Sample rate</string>
    <string name="nag_lab_option_bits">Bit depth</string>
    <string name="nag_lab_usb_describe">USB DAC formats</string>
    <string name="nag_lab_usb_describe_desc">Reads the DAC\'s USB Audio Class descriptors directly: formats, clock and sample rates.</string>
    <string name="nag_lab_usb_tone">Direct USB output test</string>
    <string name="nag_lab_usb_tone_desc">Plays a 1 kHz tone straight to the DAC with libusb, around the Android mixer. Android\'s own USB output pauses meanwhile.</string>
    <string name="nag_lab_dv_convert">Dolby Vision P7 → P8.1</string>
    <string name="nag_lab_dv_convert_desc">Pick a remux, then where to save the result: the base layer is copied as is, the enhancement layer dropped, the RPU converted.</string>
    <string name="nag_lab_whisper">Subtitles from speech (whisper)</string>
    <string name="nag_lab_whisper_desc">Transcribes the start of a file in Turkish on this device and reports the speed. The model is downloaded once.</string>
