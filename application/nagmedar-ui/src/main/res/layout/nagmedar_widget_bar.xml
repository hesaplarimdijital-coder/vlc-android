<?xml version="1.0" encoding="utf-8"?>
<!-- Classic UI: the home screen widget, one row (4×1): the cover, what plays, previous, play or pause, next -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/nag_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/nagmedar_widget_background"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="8dp"
    android:paddingEnd="6dp">

    <ImageView
        android:id="@+id/nag_widget_cover"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/nagmedar_widget_cover_background"
        android:clipToOutline="true"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        android:src="@drawable/nagmedar_widget_no_cover" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="4dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/nag_widget_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:singleLine="true"
            android:text="@string/app_name"
            android:textColor="@color/nagmedar_widget_text"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/nag_widget_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:singleLine="true"
            android:text="@string/nag_widget_idle"
            android:textColor="@color/nagmedar_widget_text_secondary"
            android:textSize="12sp" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/nag_widget_previous"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/nag_previous"
        android:padding="10dp"
        android:scaleType="fitCenter"
        android:src="@drawable/nagmedar_notif_previous"
        android:tint="@color/nagmedar_widget_text" />

    <ImageButton
        android:id="@+id/nag_widget_play"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginStart="2dp"
        android:layout_marginEnd="2dp"
        android:background="@drawable/nagmedar_widget_play_background"
        android:contentDescription="@string/nag_play"
        android:padding="10dp"
        android:scaleType="fitCenter"
        android:src="@drawable/nagmedar_pip_play"
        android:tint="@color/nagmedar_widget_on_accent" />

    <ImageButton
        android:id="@+id/nag_widget_next"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/nag_next"
        android:padding="10dp"
        android:scaleType="fitCenter"
        android:src="@drawable/nagmedar_notif_next"
        android:tint="@color/nagmedar_widget_text" />
</LinearLayout>
