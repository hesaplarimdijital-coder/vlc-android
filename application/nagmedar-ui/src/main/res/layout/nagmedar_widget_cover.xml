<?xml version="1.0" encoding="utf-8"?>
<!-- Classic UI: the home screen widget, two rows (4×2): the cover beside what plays and the buttons -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/nag_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/nagmedar_widget_background"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="10dp">

    <ImageView
        android:id="@+id/nag_widget_cover"
        android:layout_width="96dp"
        android:layout_height="96dp"
        android:background="@drawable/nagmedar_widget_cover_background"
        android:clipToOutline="true"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        android:src="@drawable/nagmedar_widget_no_cover" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/nag_widget_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:maxLines="2"
            android:text="@string/app_name"
            android:textColor="@color/nagmedar_widget_text"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/nag_widget_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:singleLine="true"
            android:text="@string/nag_widget_idle"
            android:textColor="@color/nagmedar_widget_text_secondary"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/nag_widget_previous"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/nag_previous"
                android:padding="12dp"
                android:scaleType="fitCenter"
                android:src="@drawable/nagmedar_notif_previous"
                android:tint="@color/nagmedar_widget_text" />

            <ImageButton
                android:id="@+id/nag_widget_play"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/nagmedar_widget_play_background"
                android:contentDescription="@string/nag_play"
                android:padding="12dp"
                android:scaleType="fitCenter"
                android:src="@drawable/nagmedar_pip_play"
                android:tint="@color/nagmedar_widget_on_accent" />

            <ImageButton
                android:id="@+id/nag_widget_next"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/nag_next"
                android:padding="12dp"
                android:scaleType="fitCenter"
                android:src="@drawable/nagmedar_notif_next"
                android:tint="@color/nagmedar_widget_text" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
