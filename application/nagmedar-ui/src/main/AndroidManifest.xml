<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- S-1007: the alarm rings at its minute; Android 13 and later grant this to an alarm clock -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />

    <!-- S-1010: the converter runs as a foreground job: media processing on Android 15 and later, data sync before -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROCESSING" />

    <application>
        <!-- New Compose interface (preview in MVP0). Handles window resizes itself so the
             shell keeps its state when a DeX window is resized or moved between displays.
             enableOnBackInvokedCallback: the predictive Back gesture (Android 14 and later) plays the
             screens' and the details' transitions along with the finger (Desktop Kit 0.2.0); set on this
             activity only, as the classic player still reads the Back key in two of its dialogs. -->
        <activity
            android:name="app.nagmedar.ui.NagmedarActivity"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|density|keyboard|keyboardHidden|navigation|uiMode|fontScale"
            android:enableOnBackInvokedCallback="true"
            android:exported="true"
            android:label="@string/nagmedar_shell_title"
            android:resizeableActivity="true"
            android:theme="@style/Theme.Nagmedar"
            android:windowSoftInputMode="adjustResize">
            <!-- S-409: a desktop window opens at a desktop size; the launcher then opens it where it was last -->
            <layout
                android:defaultWidth="1280dp"
                android:defaultHeight="800dp"
                android:gravity="center"
                android:minWidth="480dp"
                android:minHeight="360dp" />
            <!-- S-307: windows of the library open side by side; the system offers "New window" too (Android 15) -->
            <property
                android:name="android.window.PROPERTY_SUPPORTS_MULTI_INSTANCE_SYSTEM_UI"
                android:value="true" />
        </activity>

        <!-- S-1010: WorkManager's foreground service with the types the converter's workers ask for -->
        <service
            android:name="androidx.work.impl.foreground.SystemForegroundService"
            android:foregroundServiceType="dataSync|mediaProcessing"
            tools:node="merge" />
        <!-- S-1010: the converter notification's Cancel -->
        <receiver
            android:name="app.nagmedar.ui.convert.ConvertCancelReceiver"
            android:exported="false" />
        <!-- S-1103: the podcast download notification's Cancel -->
        <receiver
            android:name="app.nagmedar.ui.podcast.DownloadCancelReceiver"
            android:exported="false" />
        <!-- S-1107: radio recording: the app kept in the foreground while stations are recorded (their
             notification has the time, the size, the track and a stop action), and the alarms of the
             scheduled recordings (set again after a restart by AlarmRescheduler below) -->
        <service
            android:name="app.nagmedar.ui.radio.record.RecordingService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
        <receiver
            android:name="app.nagmedar.ui.radio.record.RecordingAlarmReceiver"
            android:exported="false" />

        <!-- S-1007: the alarm; and setting it again after a restart or a change of the clock (the
             system's broadcasts reach a receiver that is not exported) -->
        <receiver
            android:name="app.nagmedar.ui.sleep.AlarmReceiver"
            android:exported="false" />
        <receiver
            android:name="app.nagmedar.ui.sleep.AlarmRescheduler"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED" />
            </intent-filter>
        </receiver>


        <!-- Classic UI: Nağmedar's home screen widget, in place of VLC's three -->
        <receiver
            android:name="app.nagmedar.ui.widget.PlayerWidget"
            android:exported="false"
            android:label="@string/nag_widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/nagmedar_widget_info" />
        </receiver>

        <!-- S-307: the video player is a window of its own, beside the library's: a task of its own.
             Started again from any window it is the same player (singleTask), so one session plays. -->
        <activity
            android:name="org.videolan.vlc.gui.video.VideoPlayerActivity"
            android:taskAffinity="${applicationId}.player"
            tools:node="merge" />
    </application>
</manifest>
