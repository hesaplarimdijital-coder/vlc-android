<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- S-1007: the alarm rings at its minute; Android 13 and later grant this to an alarm clock -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />

    <application>
        <!-- New Compose interface (preview in MVP0). Handles window resizes itself so the
             shell keeps its state when a DeX window is resized or moved between displays. -->
        <activity
            android:name="app.nagmedar.ui.NagmedarActivity"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|density|keyboard|keyboardHidden|navigation|uiMode|fontScale"
            android:exported="true"
            android:label="@string/nagmedar_shell_title"
            android:resizeableActivity="true"
            android:theme="@style/Theme.Nagmedar"
            android:windowSoftInputMode="adjustResize">
            <!-- S-409: a desktop window opens at a desktop size; the launcher then opens it where it was last -->
            <layout
                android:defaultWidth="1280dp"
                android:defaultHeight="800dp"
                android:gravity="center"
                android:minWidth="480dp"
                android:minHeight="360dp" />
            <!-- S-307: windows of the library open side by side; the system offers "New window" too (Android 15) -->
            <property
                android:name="android.window.PROPERTY_SUPPORTS_MULTI_INSTANCE_SYSTEM_UI"
                android:value="true" />
        </activity>

        <!-- S-1007: the alarm; and setting it again after a restart or a change of the clock (the
             system's broadcasts reach a receiver that is not exported) -->
        <receiver
            android:name="app.nagmedar.ui.sleep.AlarmReceiver"
            android:exported="false" />
        <receiver
            android:name="app.nagmedar.ui.sleep.AlarmRescheduler"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED" />
            </intent-filter>
        </receiver>

        <!-- S-307: the video player is a window of its own, beside the library's: a task of its own.
             Started again from any window it is the same player (singleTask), so one session plays. -->
        <activity
            android:name="org.videolan.vlc.gui.video.VideoPlayerActivity"
            android:taskAffinity="${applicationId}.player"
            tools:node="merge" />
    </application>
</manifest>
