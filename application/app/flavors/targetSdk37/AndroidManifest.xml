<?xml version="1.0" encoding="utf-8"?>
<!-- Android 17: the local network permission (app.nagmedar.network.LocalNetwork), in the "Nearby devices" group. Only a
     build that targets 37 declares it (app/build.gradle's onVariants): an app that targets 36 keeps the local network
     through INTERNET, and must neither declare nor ask for it -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.ACCESS_LOCAL_NETWORK" />

</manifest>
